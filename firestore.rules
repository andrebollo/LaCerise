rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // banco único e compartilhado da empresa: qualquer pessoa logada
    // (contas criadas manualmente no Firebase Console) lê e escreve
    // em todos os dados — ninguém entra sem ter sido cadastrado por
    // um administrador, mas quem entra vê e edita tudo.
    match /negocios/la-cerise/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
